# Quartus build artifacts. They sit inside variants/<name>/, one set per variant,
# because that is the Quartus project directory.
db/
incremental_db/
output_files/
atom_netlists/
simulation/
greybox_tmp/

# Generated, but tracked on purpose: variants/*/GOSOF80.qsf (scripts/gen_qsf.ps1).
# A fresh clone has to open in Quartus without running a script first.

# Backup files
*.bak
*.qws

# Quartus generated reports / logs
*.rpt
*.summary
*.smsg
*.pin
*.jdi
*.sld
*.done
*.qdf
*.sopcinfo
c5_pin_model_dump.txt
PLLJ_PLLSPE_INFO.txt

# Build/verification logs
*.log

# Windows / Office junk
Thumbs.db
desktop.ini
~$*

# NOTE: rtl/cyclone_*/*.cmp are tracked - the .qip lists them as MISC_FILE.

# Released .jic/.pof and changelog.txt: local only (scripts\release.ps1), published on
# https://lisy.dev/swrep/soundboards. Also holds the HW 5.x .jic WITH game ROMs
# (scripts\make_flash_hex.ps1 + gosof80_roms.cof), which is copyrighted.
/bin/

# Votrax verification: reference/model binaries, GHDL library, WAV/f32/txt results
# (sim/votrax/run_sim.ps1 rebuilds everything)
sim/votrax/build/
sim/flash/build/
# GOSOF80B: also holds the packed game ROMs (copyrighted)
sim/gosof80b/build/
sim/gosof886/build/
