# PLL test for the EP4CE6E22C8N core board (HW 5.x), see README.md. Hand maintained.
set_global_assignment -name FAMILY "Cyclone IV E"
set_global_assignment -name DEVICE EP4CE6E22C8
set_global_assignment -name TOP_LEVEL_ENTITY plltest
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name STRATIX_DEVICE_IO_STANDARD "3.3-V LVTTL"
set_global_assignment -name RESERVE_ALL_UNUSED_PINS "AS INPUT TRI-STATED WITH WEAK PULL-UP"
set_global_assignment -name VHDL_FILE plltest.vhd
set_global_assignment -name QIP_FILE ../../rtl/cyclone_IV/Gosof_PLL.qip
set_location_assignment PIN_24 -to clk_50
set_location_assignment PIN_1 -to LED1
set_location_assignment PIN_2 -to LED2

set_global_assignment -name LAST_QUARTUS_VERSION "22.1std.2 Lite Edition"